# ── 本地开发（默认值，可直接复制为 .env 使用）────────────────────
# 允许手机通过局域网 IP 访问；仅供本地/局域网预览，不要当生产用。
DJANGO_ALLOWED_HOSTS=*
# 固定开发用密钥。生产环境务必替换为强随机值（python -c "import secrets;print(secrets.token_urlsafe(50))")。
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me-0000000000000000
# 本地开发默认开启 DEBUG，使 runserver 能提供静态文件（CSS/JS）。
DJANGO_DEBUG=true

# ── 生产部署（复制本文件为 .env，并修改以下项）──────────────────
# DJANGO_ENVIRONMENT=production
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_SECRET_KEY=<用 secrets.token_urlsafe(50) 生成的强随机值>
# DEEPSEEK_API_KEY=<真实 key，不填则走本地 FakeProvider 兜底解析>
