# ── Personal Life OS 环境变量模板 ───────────────────────────────
# 用法：cp .env.example .env  然后按部署环境填写下面对应区块。
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密钥。

# ===== 通用（开发 + 生产都要）=====
# 必须改为一段足够长的随机串；生产环境缺失会直接拒绝启动。
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# 备份加密密钥（可选，数据导出加密用）
BACKUP_KEY=change-me-to-random-32-chars

# ===== 开发环境（本地 runserver）=====
# 设为 development 时下方 DEBUG=True 生效；ALLOWED_HOSTS 放开为 *。
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# ===== 生产环境（部署到 Railway / Render / VPS 时改用下面这组）=====
# DJANGO_ENVIRONMENT=production
# DJANGO_DEBUG=False
# 改成你的真实域名或平台分配的域名，多个用逗号分隔：
# DJANGO_ALLOWED_HOSTS=your-domain.com,lifeos.up.railway.app
# 生产模式会自动启用 HSTS / 安全 Cookie / 密码强度校验。

# ===== 数据库 =====
# 留空 → 使用 SQLite（开箱即用，适合演示 / 低并发）。
# 配置后自动切换 MySQL（兼容自管 MYSQL_* 与 Railway 插件的 MYSQL* 变量）。
MYSQL_DATABASE=personal_life_os
MYSQL_USER=lifeos
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# ===== 可选：跨进程限流（多 worker 部署时建议开启）=====
# REDIS_URL=redis://127.0.0.1:6379/1
